# Mercury Enterprise V2.0 (package 16.0.0) — environment template
# Copy to `.env` and set secrets. Never commit `.env`.
# No insecure defaults — every secret must be supplied by the operator.

DATABASE_URL=postgresql+psycopg://mercury:mercury@postgres:5432/mercury
# Production overlay requires POSTGRES_PASSWORD in .env (must match DATABASE_URL password).
# Do not keep the LAN default "mercury" on an internet-facing host.
POSTGRES_PASSWORD=
# QueuePool (PostgreSQL only; SQLite ignores these)
# MERCURY_DB_POOL_SIZE=5
# MERCURY_DB_MAX_OVERFLOW=10
# MERCURY_DB_POOL_RECYCLE=1800

# HTTP Compose on :3000 (`docker compose up --build`, no TLS profile):
# set MERCURY_ENV=development and MERCURY_SESSION_COOKIE_SECURE=false so the
# browser stores the session cookie. Keep production + Secure cookies only
# behind TLS (`docker compose --profile production`).
MERCURY_ENV=production
MERCURY_APP_NAME=Mercury Enterprise API
MERCURY_VERSION=16.0.0

# Required — no embedded demo default. Min 12 chars in production.
# Forbidden: mercury-demo, password, admin, changeme
MERCURY_AUTH_OPERATOR=operator
MERCURY_AUTH_PASSWORD=

# Cryptographic secrets (required when MERCURY_ENV=production or HTTPS_ENABLED=true).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Forbidden insecure values: changeme, secret, password, jwt_secret, cookie_secret, default, insecure, mercury-dev-pepper
JWT_SECRET=
COOKIE_SECRET=

# Public hostname for TLS / Let's Encrypt (required when HTTPS_ENABLED=true)
DOMAIN=
HTTPS_ENABLED=false
LETSENCRYPT_EMAIL=

# CORS — use https://YOUR_DOMAIN in production HTTPS deployments
MERCURY_CORS_ORIGINS=http://localhost:3000

MERCURY_SESSION_COOKIE=mercury_session
MERCURY_SESSION_SAMESITE=lax
# Forced true when MERCURY_ENV=production or HTTPS_ENABLED=true (insecure cookies refused).
# HTTP :3000 Compose: set false with MERCURY_ENV=development (see note above).
MERCURY_SESSION_COOKIE_SECURE=true
MERCURY_SESSION_TTL_SECONDS=3600

# Application-layer rate limits (NGINX also enforces edge limits)
MERCURY_RATE_LIMIT_LOGIN_PER_MINUTE=10
MERCURY_RATE_LIMIT_API_PER_MINUTE=300

MERCURY_SEED_DEMO=false
# Pilot / LAN HTTP on :3000: MERCURY_SEED_DEMO=true, MERCURY_ENV=development,
# MERCURY_SESSION_COOKIE_SECURE=false in local `.env` only — never commit `.env`.
# Production refuses MERCURY_SEED_DEMO=true at startup.

# IAM / OIDC (required when HTTPS_ENABLED=true or MERCURY_REQUIRE_OIDC=true).
# Do not insert placeholder production credentials. Leave empty until the IdP is issued.
MERCURY_AUTH_MODE=password
MERCURY_REQUIRE_OIDC=false
MERCURY_ALLOW_PASSWORD_AUTH=true
MERCURY_OIDC_ISSUER=
MERCURY_OIDC_CLIENT_ID=
MERCURY_OIDC_CLIENT_SECRET=
MERCURY_OIDC_REDIRECT_URI=
MERCURY_OIDC_SCOPES=openid profile email
MERCURY_OIDC_USERNAME_CLAIM=preferred_username
MERCURY_OIDC_DISCOVERY_URL=
# Copy jwks_uri from the IdP discovery document. Required when HTTPS/production OIDC is enabled.
# Startup validates the URL shape and does not contact the IdP. Runtime discovery must match this value.
MERCURY_OIDC_JWKS_URI=
MERCURY_OIDC_AUTO_PROVISION=false
# JWKS cache TTL and ID-token clock skew (seconds). Production OIDC verifies RS256/ES256.
MERCURY_OIDC_JWKS_CACHE_SECONDS=300
MERCURY_OIDC_CLOCK_SKEW_SECONDS=60
MERCURY_SIM_WORKSPACES=false

# Production CORS must include https://$DOMAIN when HTTPS_ENABLED=true (startup fails closed).
# Example after DNS exists: MERCURY_CORS_ORIGINS=https://YOUR_DOMAIN

# Backup encryption (optional). Path to a file containing the passphrase. Never commit the key file.
# MERCURY_BACKUP_KEY_FILE=
# MERCURY_BACKUP_RETAIN_DAYS=14
# Destructive restore requires MERCURY_RESTORE_CONFIRM=YES

MERCURY_LOG_JSON=true
LOG_LEVEL=INFO
# Optional rotating file logs (empty = stdout only)
LOG_FILE=
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

MERCURY_BUILD_VERSION=16.0.0
MERCURY_METRICS_ENABLED=true
# Off by default — domain audits already cover mutations; enable for verbose API access trails
MERCURY_AUDIT_API_ACCESS=false
MERCURY_AUDIT_RETENTION_DAYS=365

# Optional Redis — Compose sets redis://redis:6379/0 by default for shared sessions.
# Leave empty for single-process local (in-memory sessions).
# Production OIDC / HTTPS overlay requires Redis (PKCE/state has no in-memory fallback).
# docker-compose.production.yml sets REDIS_REQUIRED=true.
REDIS_URL=
REDIS_REQUIRED=false

# Local platform file object store (multipart upload). Empty → ./data/platform_files
MERCURY_FILE_STORAGE_ROOT=

# Publications local filesystem locators (metadata only). Empty → ./data/publications
MERCURY_PUBLICATIONS_STORAGE_ROOT=

# Optional machine API key (X-API-Key / Bearer). Empty = session cookie only.
# When set, constant-time compare; org/site via MERCURY_API_KEY_ORG_ID / SITE_ID / ROLE.
MERCURY_API_KEY=
MERCURY_API_KEY_ORG_ID=org-aviation-east
MERCURY_API_KEY_SITE_ID=site-cyul
MERCURY_API_KEY_ROLE=Operator

# Password hashing — Argon2id (OWASP-ish defaults). Do not lower in production.
# MERCURY_ARGON2_TIME_COST=2
# MERCURY_ARGON2_MEMORY_KIB=19456
# MERCURY_ARGON2_PARALLELISM=1
