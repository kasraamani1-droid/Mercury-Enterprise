# Mercury Enterprise V2.0 (package 16.0.0) — environment template
# Copy to `.env` and set secrets. Never commit `.env`.

DATABASE_URL=postgresql+psycopg://mercury:mercury@postgres:5432/mercury

MERCURY_ENV=production
MERCURY_APP_NAME=Mercury Enterprise API
MERCURY_VERSION=16.0.0

# Required — no embedded demo default. Min 12 chars in production. Forbidden: mercury-demo, password, admin, changeme
MERCURY_AUTH_OPERATOR=operator
MERCURY_AUTH_PASSWORD=

MERCURY_CORS_ORIGINS=http://localhost:3000
MERCURY_SESSION_COOKIE=mercury_session
MERCURY_SESSION_SAMESITE=lax
MERCURY_SESSION_COOKIE_SECURE=true
MERCURY_SESSION_TTL_SECONDS=3600

MERCURY_SEED_DEMO=false
MERCURY_LOG_JSON=true
MERCURY_AUDIT_RETENTION_DAYS=365
